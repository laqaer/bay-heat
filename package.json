{
  "name": "bayheat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BayHeat \u2014 the independent garage climate lab. Garage heat-load planner, safety verdicts, and cost data. (Mogul factory Site #1, Laqaer Products.)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/cloudflare-routing.mjs",
    "start": "npx --yes wrangler@4.135.0 dev --port 3000",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "node --test 'lib/**/*.test.ts' 'scripts/*.test.mjs'",
    "check": "npm run typegen && npm run typecheck && npm run lint && npm test && npm run build && npm run check:affiliates && npm run check:affiliates:control && npm run qa",
    "qa": "node scripts/smoke.mjs",
    "check:affiliates": "node scripts/link-audit.mjs --check --dir out",
    "check:affiliates:control": "node scripts/check-affiliates-control.mjs",
    "check:editorial": "node scripts/editorial-gate.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
